//@version=6
// Momentum -> Base -> Contraction -> Breakout indicator (one signal per base).
//  Blue bg = momentum (hVol gap / orderly persistent buying)   Orange bg = base (pullback)
//  Orange dots = contraction (ATR contraction AND EMA compression AND tight closes / inside day)
//  Green candle = entry. Default: day after a contraction dot, opening-window (11 min) volume >= 8% of
//  50d avg daily volume, buy on break of the opening-range high. Alt mode: daily breakout close.
// State machine: IDLE -> MOMENTUM -> BASE -> (contraction) -> BREAKOUT -> back to MOMENTUM (needs a new base).
// Trade levels (visual only): stop = tighter of contraction low / 2.5%, BE at 2R, book 25% at 4R,
// sell all on a daily close below EMA21.
indicator("Momentum Base Breakout", overlay = true, max_labels_count = 500)

// ───────── Inputs ─────────
grpM = "1. Momentum"
gapPct      = input.float(4.0, "hVol gap: min gap % above prior high", group = grpM)
gapVolMult  = input.float(2.5, "hVol gap: volume x 50d avg", group = grpM)
rocLen      = input.int(20, "Orderly buying: ROC length", group = grpM)
rocMin      = input.float(25.0, "Orderly buying: min ROC %", group = grpM)
upDaysLen   = input.int(10, "Orderly buying: lookback", group = grpM)
upDaysMin   = input.int(7, "Orderly buying: min up closes", group = grpM)
momValid    = input.int(40, "Momentum expires after N bars without new high", group = grpM)

grpB = "2. Base"
pbMinPct    = input.float(5.0, "Pullback: min % off momentum high", group = grpB)
pbMaxPct    = input.float(25.0, "Pullback: max % off momentum high", group = grpB)
minBaseBars = input.int(3, "Base: min bars since momentum high", group = grpB)
needAbove50 = input.bool(true, "Base must hold above EMA50", group = grpB)

grpC = "3. Contraction (all must pass)"
atrFast     = input.int(5, "ATR fast", group = grpC)
atrSlow     = input.int(20, "ATR slow", group = grpC)
atrRatio    = input.float(0.85, "ATR contraction: fast/slow <=", group = grpC)
emaCompATR  = input.float(1.0, "EMA compression: |EMA10-EMA21| <= x ATR", group = grpC)
tightLen    = input.int(3, "Tight closes: bars", group = grpC)
tightATR    = input.float(0.8, "Tight closes: close range <= x ATR", group = grpC)

grpX = "4. Breakout"
bkWindow    = input.int(10, "Breakout within N bars of last contraction", group = grpX)
rangeMult   = input.float(1.0, "Range expansion: bar range >= x fast ATR", group = grpX)
closePos    = input.float(0.65, "Close in top x of bar range", group = grpX)
volMult     = input.float(1.2, "Volume >= x 50d avg", group = grpX)
cooldown    = input.int(10, "Min bars between signals", group = grpX)

grpI = "Entry"
entryMode   = input.string("Next-day ORH + RVOL", "Entry mode", options = ["Next-day ORH + RVOL", "Daily breakout close"], group = grpI)
orMins      = input.int(11, "Opening window (minutes)", group = grpI)
rvolPct     = input.float(8.0, "Volume in opening window >= % of 50d avg daily volume", group = grpI)
ltf         = input.timeframe("1", "Intraday timeframe for ORH/RVOL", group = grpI)
orhMode     = entryMode == "Next-day ORH + RVOL"

grpE = "Trade levels"
showLevels  = input.bool(true, "Show stop / target / exit markers", group = grpE)
maxStopPct  = input.float(2.5, "Max stop % (tighter of contraction low / this)", group = grpE)
beR         = input.float(2.0, "Move stop to breakeven at (R)", group = grpE)
partR       = input.float(4.0, "Book partial at (R), 0 = off", group = grpE)
partPct     = input.float(25.0, "Partial size %", group = grpE)
trailLen    = input.int(21, "Exit all on close below EMA", group = grpE)

grpF = "Market filter"
useMkt      = input.bool(true, "Signal only when index > its EMA", group = grpF)
mktSym      = input.symbol("NSE:NIFTY", "Index", group = grpF)
mktLen      = input.int(50, "Index EMA length", group = grpF)

// ───────── Series ─────────
ema10 = ta.ema(close, 10)
ema21 = ta.ema(close, 21)
ema50 = ta.ema(close, 50)
emaTr = ta.ema(close, trailLen)
atrF  = ta.atr(atrFast)
atrS  = ta.atr(atrSlow)
vAvg  = ta.sma(volume, 50)
hiT   = ta.highest(high, tightLen)
loT   = ta.lowest(low, tightLen)
upCnt = math.sum(close > close[1] ? 1 : 0, upDaysLen)
roc   = ta.roc(close, rocLen)

// ───────── Intraday (lower-TF) data for next-day ORH entry ─────────
[ltfT, ltfO, ltfH, ltfL, ltfV] = request.security_lower_tf(syminfo.tickerid, ltf, [time, open, high, low, volume])
orVol   = 0.0
orHigh  = float(na)
trigPx  = float(na)   // entry fill: opening-range high, or the bar's open if it gapped above
lowPre  = float(na)   // day low up to and including the trigger bar
lowPost = float(na)   // lowest low after the trigger bar (same-day stop check)
n = array.size(ltfT)
if n > 0
    t0 = array.get(ltfT, 0)
    for k = 0 to n - 1
        tk = array.get(ltfT, k)
        hk = array.get(ltfH, k)
        lk = array.get(ltfL, k)
        if tk - t0 < orMins * 60000
            orVol  += array.get(ltfV, k)
            orHigh := na(orHigh) ? hk : math.max(orHigh, hk)
            lowPre := na(lowPre) ? lk : math.min(lowPre, lk)
        else if na(trigPx)
            lowPre := math.min(lowPre, lk)
            if hk > orHigh
                trigPx := math.max(orHigh, array.get(ltfO, k))
        else
            lowPost := na(lowPost) ? lk : math.min(lowPost, lk)
rvolOK = orVol >= rvolPct / 100 * nz(vAvg[1])

mktClose = request.security(mktSym, "D", close, lookahead = barmerge.lookahead_off)
mktEma   = request.security(mktSym, "D", ta.ema(close, mktLen), lookahead = barmerge.lookahead_off)
mktOK    = not useMkt or (mktClose > mktEma)

// ───────── 1. Momentum events ─────────
hVolGap = open >= high[1] * (1 + gapPct / 100) and volume >= gapVolMult * vAvg and close > open
orderly = roc >= rocMin and upCnt >= upDaysMin and close > ema10 and ema10 > ema21 and ema21 > ema50
momBar  = hVolGap or orderly

// ───────── Contraction test (bar-level) ─────────
atrContr  = atrF <= atrRatio * atrS
emaComp   = math.abs(ema10 - ema21) <= emaCompATR * atrS
tight     = ta.highest(close, tightLen) - ta.lowest(close, tightLen) <= tightATR * atrS
insideDay = high < high[1] and low > low[1]
contrTest = atrContr and emaComp and (tight or insideDay)

// ───────── State machine ─────────
// 0 = idle, 1 = momentum (waiting for pullback), 2 = base (pullback in progress)
var int   state      = 0
var float momHigh    = na
var int   momHighBar = na
var float contrHigh  = na
var float contrLow   = na
var int   contrBar   = na
var int   lastSig    = na

contraction = false
breakout    = false

// momentum: start or extend
if momBar
    if state == 0
        state := 1
    momHigh    := na(momHigh) or high > momHigh ? high : momHigh
    momHighBar := high >= momHigh ? bar_index : momHighBar
else if state > 0 and high > momHigh
    momHigh    := high
    momHighBar := bar_index

// expire stale momentum
if state > 0 and bar_index - momHighBar > momValid
    state := 0
    momHigh := na
    contrHigh := na

pbPct = na(momHigh) ? na : (momHigh - low) / momHigh * 100

// momentum -> base once price has pulled back enough
if state == 1 and pbPct >= pbMinPct and bar_index - momHighBar >= minBaseBars
    state := 2

// base invalidation: too deep or lost EMA50 -> idle
if state == 2 and (pbPct > pbMaxPct or (needAbove50 and close < ema50))
    state := 0
    momHigh := na
    contrHigh := na

// contraction inside base
if state == 2 and contrTest and bar_index - momHighBar >= minBaseBars
    contraction := true
    contrHigh := hiT
    contrLow  := loT
    contrBar  := bar_index

// breakout: first close above contraction high, within window, expansion, near high, volume
rng = high - low
if not orhMode and state == 2 and not na(contrHigh) and not contraction
    inWindow  = bar_index - contrBar <= bkWindow
    firstPush = close > contrHigh and close[1] <= contrHigh
    expand    = rng >= rangeMult * atrF[1]
    nearHigh  = rng > 0 and (close - low) / rng >= closePos
    volOK     = volume >= volMult * vAvg
    coolOK    = na(lastSig) or bar_index - lastSig >= cooldown
    if inWindow and firstPush and expand and nearHigh and volOK and coolOK and close > ema10
        breakout := true
        lastSig := bar_index
        // reset: next signal needs a fresh pullback + contraction
        state := 1
        momHigh := high
        momHighBar := bar_index
    else if bar_index - contrBar > bkWindow
        contrHigh := na   // contraction window expired; wait for a new one

// next-day ORH entry: yesterday was a contraction dot, opening-window volume >= rvolPct of avg,
// then price trades above the opening-range high (HOD at that time)
orhSignal = false
if orhMode and contraction[1] and state == 2 and rvolOK and not na(trigPx) and (na(lastSig) or bar_index - lastSig >= cooldown)
    orhSignal := true
    breakout := true
    lastSig := bar_index
    state := 1
    momHigh := high
    momHighBar := bar_index

// ───────── Visuals ─────────
bgcolor(state == 1 ? color.new(color.blue, 88) : state == 2 ? color.new(color.orange, 85) : na)
plotshape(contraction, "Contraction", shape.circle, location.abovebar, color.orange, size = size.tiny)
barcolor(breakout ? color.lime : na)
plot(ema10, "EMA10", color.new(color.orange, 30))
plot(ema21, "EMA21", color.new(color.blue, 30))
plot(ema50, "EMA50", color.new(color.green, 30))

// ───────── Trade levels (simulated, one setup at a time) ─────────
// Stop = tighter of contraction low and entry - maxStopPct. BE at beR. Book partPct at partR.
// Exit everything on a daily close below the trail EMA.
entryNow = orhSignal ? trigPx : close
stopCand = orhSignal ? math.max(contrLow, lowPre, entryNow * (1 - maxStopPct / 100)) : math.max(contrLow, entryNow * (1 - maxStopPct / 100))
stopDist = entryNow - stopCand
signal   = breakout and mktOK and stopDist > 0

var bool  active   = false
var float entryPx  = na
var float stopPx   = na
var float riskR    = na
var bool  atBE     = false
var bool  booked   = false
var int   entryBar = na

exitNow = false
exitWhy = ""
if active and bar_index > entryBar
    if low <= stopPx
        exitNow := true
        exitWhy := atBE ? "BE stop" : "Stop"
    else
        if partR > 0 and not booked and high >= entryPx + partR * riskR
            booked := true
            if showLevels
                label.new(bar_index, high, "Book " + str.tostring(partPct, "#") + "%\n@" + str.tostring(partR, "#.#") + "R", style = label.style_label_down, color = color.new(color.green, 20), textcolor = color.white, size = size.small)
        if not atBE and high >= entryPx + beR * riskR
            atBE := true
            stopPx := math.max(stopPx, entryPx)
            if showLevels
                label.new(bar_index, high, "BE", style = label.style_label_down, color = color.new(color.gray, 20), textcolor = color.white, size = size.tiny)
        if close < emaTr
            exitNow := true
            exitWhy := "Close < EMA" + str.tostring(trailLen) + "\nsell all"
if exitNow
    active := false
    if showLevels
        label.new(bar_index, high, "Exit\n" + exitWhy, style = label.style_label_down, color = color.new(color.red, 20), textcolor = color.white, size = size.small)

if signal and not active
    active   := true
    entryPx  := entryNow
    stopPx   := stopCand
    riskR    := stopDist
    atBE     := false
    booked   := false
    entryBar := bar_index
    if showLevels
        label.new(bar_index, low, (orhSignal ? "BUY ORH " : "BUY ") + str.tostring(entryNow, format.mintick) + "\nSL " + str.tostring(stopCand, format.mintick) + " (" + str.tostring(stopDist / entryNow * 100, "#.#") + "%)", style = label.style_label_up, color = color.new(color.lime, 10), textcolor = color.black, size = size.small)

// same-day stop for intraday entries
if active and entryBar == bar_index and orhSignal and not na(lowPost) and lowPost <= stopPx
    active := false
    exitNow := true
    if showLevels
        label.new(bar_index, high, "Exit\nSame-day stop", style = label.style_label_down, color = color.new(color.red, 20), textcolor = color.white, size = size.small)

plot(showLevels and active ? stopPx : na, "Stop", color.red, 2, plot.style_linebr)
plot(showLevels and active and not atBE ? entryPx + beR * riskR : na, "BE trigger", color.gray, 1, plot.style_linebr)
plot(showLevels and active and partR > 0 and not booked ? entryPx + partR * riskR : na, "Book target", color.green, 1, plot.style_linebr)
plot(emaTr, "Exit EMA", color.new(color.purple, 40))

// ───────── Alerts ─────────
alertcondition(signal, "Breakout", "{{ticker}} momentum-base breakout, close {{close}}")
alertcondition(contraction, "Contraction (arm for next-day ORH)", "{{ticker}} contraction in base (setup developing)")
alertcondition(exitNow, "Exit", "{{ticker}} exit signal (stop or trail EMA)")
