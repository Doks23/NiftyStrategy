//@version=6
// Momentum -> Base -> Contraction -> Breakout (replica of the "VTG" style indicator), with exits.
// Stages:
//  1. Momentum  (blue bg): high-volume gap up OR orderly, persistent buying.
//  2. Base      (orange bg): after momentum, price pulls back off the momentum high.
//  3. Contraction (orange dots): ATR contracts, EMAs compress, tight closes and/or inside day.
//  4. Breakout  (green candle): range expands out of the contraction, close near the day's high.
// Exits: stop at contraction low (or breakout-bar low), sell part at N R -> stop to breakeven,
//        trail the rest on a close below the trail EMA. Optional index market filter.
strategy("Momentum Base Breakout", overlay = true, pyramiding = 0,
     initial_capital = 1000000, currency = currency.NONE,
     commission_type = strategy.commission.percent, commission_value = 0.1, slippage = 2,
     process_orders_on_close = true)

// ───────── Inputs ─────────
grpM = "1. Momentum"
gapPct      = input.float(3.0, "hVol gap: min gap %", group = grpM)
gapVolMult  = input.float(2.0, "hVol gap: volume x 50d avg", group = grpM)
rocLen      = input.int(20, "Orderly buying: ROC length", group = grpM)
rocMin      = input.float(20.0, "Orderly buying: min ROC %", group = grpM)
upDaysLen   = input.int(10, "Orderly buying: lookback", group = grpM)
upDaysMin   = input.int(7, "Orderly buying: min up closes", group = grpM)
momValid    = input.int(40, "Momentum valid for N bars", group = grpM)

grpB = "2. Base / 3. Contraction"
pbMinPct    = input.float(4.0, "Pullback: min % off momentum high", group = grpB)
pbMaxPct    = input.float(30.0, "Pullback: max % off momentum high", group = grpB)
atrFast     = input.int(5, "ATR fast", group = grpB)
atrSlow     = input.int(20, "ATR slow", group = grpB)
atrRatio    = input.float(0.8, "ATR contraction: fast/slow <=", group = grpB)
emaCompATR  = input.float(1.0, "EMA compression: |EMA10-EMA21| <= x ATR", group = grpB)
tightLen    = input.int(3, "Tight closes: bars", group = grpB)
tightATR    = input.float(0.75, "Tight closes: close range <= x ATR", group = grpB)
needEmaComp = input.bool(true, "Require EMA compression", group = grpB)

grpX = "4. Breakout"
bkWindow    = input.int(5, "Breakout within N bars of contraction", group = grpX)
rangeMult   = input.float(1.2, "Range expansion: bar range >= x fast ATR", group = grpX)
closePos    = input.float(0.75, "Close in top x of bar range", group = grpX)
volMult     = input.float(1.0, "Volume >= x 50d avg", group = grpX)

grpE = "Exits & Risk"
riskPct     = input.float(0.5, "Risk % of equity per trade", group = grpE)
maxPosPct   = input.float(25.0, "Max position % of equity", group = grpE)
stopMode    = input.string("Contraction low", "Initial stop", options = ["Contraction low", "Breakout bar low"], group = grpE)
maxStopPct  = input.float(8.0, "Skip if stop wider than %", group = grpE)
partR       = input.float(3.0, "Partial target (R), 0 = off", group = grpE)
partPct     = input.float(33.0, "Partial size %", group = grpE)
trailLen    = input.int(21, "Trail EMA length (close below = exit)", group = grpE)

grpF = "Market filter"
useMkt      = input.bool(true, "Only trade when index > its EMA", group = grpF)
mktSym      = input.symbol("NSE:NIFTY", "Index", group = grpF)
mktLen      = input.int(50, "Index EMA length", group = grpF)

// ───────── Indicators ─────────
ema10  = ta.ema(close, 10)
ema21  = ta.ema(close, 21)
ema50  = ta.ema(close, 50)
emaTr  = ta.ema(close, trailLen)
atrF   = ta.atr(atrFast)
atrS   = ta.atr(atrSlow)
vAvg   = ta.sma(volume, 50)

// ───────── 1. Momentum ─────────
hVolGap  = open >= high[1] * (1 + gapPct / 100) and volume >= gapVolMult * vAvg and close > open
upCount  = math.sum(close > close[1] ? 1 : 0, upDaysLen)
orderly  = ta.roc(close, rocLen) >= rocMin and upCount >= upDaysMin and close > ema10 and ema10 > ema21
momBar   = hVolGap or orderly
barsMom  = ta.barssince(momBar)
inMom    = not na(barsMom) and barsMom <= momValid

// Momentum high = highest high since the momentum run started (resets on each fresh momentum bar)
var float momHigh = na
if momBar
    momHigh := na(momHigh) ? high : math.max(momHigh, high)
else if inMom
    momHigh := math.max(nz(momHigh, high), high)
else
    momHigh := na

// ───────── 2. Base & 3. Contraction ─────────
pbPct      = na(momHigh) ? na : (momHigh - low) / momHigh * 100
inBase     = inMom and not momBar and pbPct >= pbMinPct and pbPct <= pbMaxPct and close > ema50
atrContr   = atrF <= atrRatio * atrS
emaComp    = math.abs(ema10 - ema21) <= emaCompATR * atrS
tight      = ta.highest(close, tightLen) - ta.lowest(close, tightLen) <= tightATR * atrS
insideDay  = high < high[1] and low > low[1]
contraction = inBase and atrContr and (not needEmaComp or emaComp) and (tight or insideDay)

barsContr  = ta.barssince(contraction)
hiT        = ta.highest(high, tightLen)
loT        = ta.lowest(low, tightLen)
var float contrHigh = na
var float contrLow  = na
if contraction
    contrHigh := hiT
    contrLow  := loT

// ───────── 4. Breakout ─────────
rng       = high - low
expansion = rng >= rangeMult * atrF[1]
nearHigh  = rng > 0 and (close - low) / rng >= closePos
breakout  = not na(barsContr) and barsContr >= 1 and barsContr <= bkWindow and inMom and
     close > contrHigh and expansion and nearHigh and volume >= volMult * vAvg

mktClose = request.security(mktSym, "D", close, lookahead = barmerge.lookahead_off)
mktEma   = request.security(mktSym, "D", ta.ema(close, mktLen), lookahead = barmerge.lookahead_off)
mktOK    = not useMkt or (mktClose > mktEma)

// ───────── Visuals (same legend as the screenshot) ─────────
bgcolor(momBar or (inMom and not inBase and barsMom <= 3) ? color.new(color.blue, 85) : inBase ? color.new(color.orange, 85) : na)
plotshape(contraction, "Contraction", shape.circle, location.abovebar, color.orange, size = size.tiny)
barcolor(breakout ? color.lime : na)
plot(ema10, "EMA10", color.new(color.orange, 30))
plot(ema21, "EMA21", color.new(color.blue, 30))
plot(ema50, "EMA50", color.new(color.green, 30))

// ───────── Entries ─────────
var float entryPx = na
var float stopPx  = na
var float initR   = na
var bool  parted  = false

stopCand = stopMode == "Contraction low" ? contrLow : low
stopDist = close - stopCand
stopOK   = stopDist > 0 and stopDist / close * 100 <= maxStopPct

if breakout and mktOK and stopOK and strategy.position_size == 0
    eq     = strategy.equity
    qtyR   = eq * riskPct / 100 / stopDist
    qtyCap = eq * maxPosPct / 100 / close
    qty    = math.floor(math.min(qtyR, qtyCap))
    if qty > 0
        strategy.entry("L", strategy.long, qty = qty, comment = "Breakout")
        entryPx := close
        stopPx  := stopCand
        initR   := stopDist
        parted  := false

// ───────── Exits ─────────
if strategy.position_size > 0
    // partial at partR -> move stop to breakeven
    if partR > 0 and not parted and high >= entryPx + partR * initR
        parted := true
        stopPx := math.max(stopPx, entryPx)
    if partR > 0 and not parted
        strategy.exit("Part", "L", qty_percent = partPct, limit = entryPx + partR * initR, stop = stopPx, comment_profit = "Partial", comment_loss = "Stop")
    strategy.exit("Rest", "L", stop = stopPx, comment_loss = parted ? "BE stop" : "Stop")
    // trail: daily close below trail EMA -> exit (fills at this close with process_orders_on_close)
    if close < emaTr and bar_index > strategy.opentrades.entry_bar_index(0)
        strategy.close("L", comment = "Trail EMA" + str.tostring(trailLen))

plot(strategy.position_size > 0 ? stopPx : na, "Stop", color.red, style = plot.style_linebr)
plot(strategy.position_size > 0 and partR > 0 and not parted ? entryPx + partR * initR : na, "Target", color.green, style = plot.style_linebr)

// ───────── Alerts ─────────
alertcondition(breakout, "Breakout", "{{ticker}} momentum-base breakout")
alertcondition(contraction, "Contraction", "{{ticker}} contraction in base (setup developing)")
